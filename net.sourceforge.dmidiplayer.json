{
  "app-id": "net.sourceforge.dmidiplayer",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
  "command": "dmidiplayer",
  "rename-icon": "dmidiplayer",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--filesystem=xdg-run/pipewire-0",
    "--filesystem=home",
    "--device=dri",
    "--env=TMPDIR=/var/tmp",
    "--env=ALSA_CONFIG_PATH="
  ],
  "cleanup": [
    "/share/man",
    "/share/doc",
    "/share/gtk-doc",
    "*.la"
  ],
  "modules": [
    {
      "name": "fluidsynth",
      "buildsystem": "cmake-ninja",
      "cleanup": [
          "/bin",
          "/include",
          "/lib/cmake",
          "/lib/pkgconfig",
          "/share/man",
          "*.so"
      ],
      "sources": [
          {
              "type": "archive",
              "url": "https://github.com/FluidSynth/fluidsynth/archive/v2.6.2.tar.gz",
              "sha256": "ca376b42a3c1b186a4c8c248931789a455ac94a89b777394969d678010c2f91f"
          },
          {
            "type": "git",
            "url": "https://github.com/kthohr/gcem.git",
            "commit": "012ae73c6d0a2cb09ffe86475f5c6fba3926e200",
            "dest": "gcem"
          }
      ]
    },
    {
      "name": "sonivox",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_TESTING=OFF"
      ],
      "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/lib/*.so"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/EmbeddedSynth/sonivox/archive/v4.0.2.tar.gz",
          "sha256": "5c513d7a6fa0ebf61afd3b96da881e3014edf53acfb8d08a63dd853fca37c1fa"
        }
      ]
    },
    {
      "name": "drumstick",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_ALSA=ON", 
        "-DBUILD_FILE=ON", 
        "-DBUILD_RT=ON", 
        "-DBUILD_WIDGETS=ON",
        "-DBUILD_DOCS=OFF",
        "-DBUILD_UTILS=OFF",
        "-DBUILD_TESTING=OFF"
      ],
      "cleanup": [
        "/bin",
        "/include",
        "/lib/cmake",
        "/lib/plugins",
        "/lib/pkgconfig",
        "/share/mime",
        "/share/icons/hicolor/*/apps",
        "*.desktop",
        "/lib/*.so"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://downloads.sourceforge.net/project/drumstick/2.11.2/drumstick-2.11.2.tar.gz",
          "sha256": "0a40d1bdd301c8e1138578474cf93a923013265503c513b53ce83d043d443ce8"
        }
      ]
    },
    {
      "name": "uchardet",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_STATIC=OFF",
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
      ],
      "cleanup": [
        "/bin",
        "/include",
        "/lib/pkgconfig",
        "/share",
        "/lib/*.so"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://www.freedesktop.org/software/uchardet/releases/uchardet-0.0.8.tar.xz",
          "sha256": "e97a60cfc00a1c147a674b097bb1422abd9fa78a2d9ce3f3fdcc2e78a34ac5f0"
        }
      ]
    },
    {
      "name": "KDSingleApplication",
      "buildsystem": "cmake-ninja",
      "cleanup": [
          "/bin",
          "/include",
          "/lib/cmake",
          "*.so"
      ],
      "sources": [
          {
              "type": "archive",
              "url": "https://github.com//KDAB/KDSingleApplication/archive/v1.2.1.tar.gz",
              "sha256": "e3254ce9dc5ecf6d61ef83264bc61d486a307f0e3c9ed1bb2176f068cdbcbe09"
          }
      ]
    },
    {
      "name": "dmidiplayer",
      "buildsystem": "cmake-ninja",
      "config-opts": [ "-DBUILD_DOCS=OFF" ],
      "sources": [
        {
          "type": "archive",
          "url": "http://downloads.sourceforge.net/project/dmidiplayer/v1.8.0/dmidiplayer-1.8.0.tar.gz",
          "sha256": "c2a6a66aa4e1bee72e38a03d02039a5ee138523a92d66fccac2da09614547961"
        }
      ]
    }
  ]
}
